# ==============================================================================
# ZERUBBABEL (CEPHAS EA) ENVIRONMENT CONFIGURATION
# 100% Phone-Hosted Autonomous AI Executive Assistant
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & DAEMON SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4892
HOST=0.0.0.0
API_KEY=zerub-secure-local-token
DATABASE_PATH=./data/zerubbabel.db

# ------------------------------------------------------------------------------
# 2. EXECUTIVE PHONE IDENTITIES
# ------------------------------------------------------------------------------
# Cephas's Personal WhatsApp Number (E.164 format without '+')
CEPHAS_PERSONAL_PHONE=2348072854186

# Zerubbabel's Dedicated Assistant Line Number (E.164 format without '+')
ZERUB_ASSISTANT_PHONE=2347051627659

# Assistant Name and Outbound Signature
ASSISTANT_NAME=Zerubbabel
OUTBOUND_SIGNATURE=— Sent on behalf of Cephas by Zerubbabel (Executive Assistant)

# ------------------------------------------------------------------------------
# 3. DUAL-WHATSAPP SOCKET STORAGE PATHS
# ------------------------------------------------------------------------------
AUTH_DIR_PERSONAL=./auth/personal
AUTH_DIR_ASSISTANT=./auth/bot

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI MULTI-TIER AI ENGINE
# ------------------------------------------------------------------------------
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Tier 1: Fast Router (Ultra-Lightweight sub-second classification & triage)
MODEL_TIER1_ROUTER=gemini-2.0-flash-lite

# Tier 2: The Workhorse Engine (Tool calling, executive chat, drafts, group replies)
MODEL_TIER2_WORKHORSE=gemini-2.5-flash

# Tier 3: Deep Strategic & Heavy Multimodal Engine (Long audio meetings, strategic synthesis)
MODEL_TIER3_DEEP=gemini-2.5-pro

# ------------------------------------------------------------------------------
# 5. GOOGLE WORKSPACE (DRIVE, DOCS, CALENDAR, TASKS, CONTACTS)
# ------------------------------------------------------------------------------
# Path to Google OAuth Client Secret JSON or Service Account Key
GOOGLE_CREDENTIALS_PATH=./credentials/google-credentials.json
GOOGLE_TOKEN_PATH=./credentials/google-token.json

# Target Google Drive folder for meeting notes
GOOGLE_DRIVE_MEETING_FOLDER_NAME=Zerubbabel Meeting Summaries
